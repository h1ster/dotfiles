# Скриншот всего экрана по Print
Print
    /bin/sh -c "sleep 0.1 && /usr/local/bin/scrot '%Y-%m-%d-%H%M%S_\$wx\$hp_scrot.png' -e 'mv \$f ~/Pictures/ && xclip -selection clipboard -t image/png ~/Pictures/\$f'"

# Скриншот области по Super + Print (вместо Alt)
super + Print
    /bin/sh -c "sleep 0.1 && /usr/local/bin/scrot -s '%Y-%m-%d-%H%M%S_\$wx\$hp_scrot.png' -e 'mv \$f ~/Pictures/ && xclip -selection clipboard -t image/png ~/Pictures/\$f'"

